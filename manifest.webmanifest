{
  "name": "Scentcast",
  "short_name": "Scentcast",
  "description": "What to wear today from your fragrance collection, based on the weather and the occasion.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0b0c11",
  "theme_color": "#0b0c11",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "shortcuts": [
